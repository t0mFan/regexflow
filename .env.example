# Run: python3 scripts/configure.py
DJANGO_SECRET_KEY=replace-with-generated-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key
POSTGRES_PASSWORD=replace-with-generated-password
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# 1 uses the configured real provider with sample data; 0 uses preset demo rules.
DEMO_USE_LIVE_AI=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEMO_ENABLED=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
COOKIE_SECURE=0
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
